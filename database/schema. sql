
-- VitalLoop: Blood Resource Network
-- Database schema - MySQL

CREATE DATABASE IF NOT EXISTS vitalloop;

USE vitalloop;

-- 1. Users and account roles
CREATE TABLE IF NOT EXISTS users (
    user_id INT AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    role ENUM('DONOR', 'REQUESTER', 'ADMIN')
        NOT NULL DEFAULT 'DONOR',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. Donor profiles
CREATE TABLE IF NOT EXISTS donors (
    donor_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL UNIQUE,
    blood_group ENUM(
        'A+', 'A-', 'B+', 'B-',
        'AB+', 'AB-', 'O+', 'O-'
    ) NOT NULL,
    city VARCHAR(100) NOT NULL,
    availability ENUM(
        'AVAILABLE', 'UNAVAILABLE'
    ) NOT NULL DEFAULT 'UNAVAILABLE',
    consent_to_contact BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_donor_user
        FOREIGN KEY (user_id)
        REFERENCES users(user_id)
        ON DELETE CASCADE,

    INDEX idx_donor_search (blood_group, city, availability)
);

-- 3. Blood requests
CREATE TABLE IF NOT EXISTS blood_requests (
    request_id INT AUTO_INCREMENT PRIMARY KEY,
    requester_id INT NOT NULL,
    blood_group ENUM(
        'A+', 'A-', 'B+', 'B-',
        'AB+', 'AB-', 'O+', 'O-'
    ) NOT NULL,
    units_requested TINYINT UNSIGNED NOT NULL,
    city VARCHAR(100) NOT NULL,
    hospital_name VARCHAR(150) NOT NULL,
    status ENUM(
        'OPEN', 'IN_PROGRESS',
        'FULFILLED', 'CANCELLED'
    ) NOT NULL DEFAULT 'OPEN',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT chk_units
        CHECK (units_requested BETWEEN 1 AND 10),

    CONSTRAINT fk_request_user
        FOREIGN KEY (requester_id)
        REFERENCES users(user_id),

    INDEX idx_request_search (blood_group, city, status)
);

-- 4. Donor/request coordination records
CREATE TABLE IF NOT EXISTS request_matches (
    match_id INT AUTO_INCREMENT PRIMARY KEY,
    request_id INT NOT NULL,
    donor_id INT NOT NULL,
    status ENUM(
        'PENDING', 'CONTACTED',
        'ACCEPTED', 'DECLINED', 'CLOSED'
    ) NOT NULL DEFAULT 'PENDING',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_match_request
        FOREIGN KEY (request_id)
        REFERENCES blood_requests(request_id)
        ON DELETE CASCADE,

    CONSTRAINT fk_match_donor
        FOREIGN KEY (donor_id)
        REFERENCES donors(donor_id)
        ON DELETE CASCADE,

    CONSTRAINT uq_request_donor
        UNIQUE (request_id, donor_id)
);
